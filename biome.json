{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "shared はサーバーの全層から使うため、サーバーのコードに依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/application/**", "**/infrastructure/**", "**/entry/**"],
                    "message": "ドメイン層は他の層に依存しない（shared だけ使える）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "**/entry/**"],
                    "message": "アプリケーション層はインフラ層や入口に依存しない。必要なものは ports に定義する。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/infrastructure/gas/**", "src/server/entry/gas.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/entry/**"],
                    "message": "インフラ層から入口へは依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
