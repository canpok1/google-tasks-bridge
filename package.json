{
  "name": "google-tasks-bridge",
  "description": "Google ToDo リスト（Google Tasks）を Claude Code から読み書きするための Apps Script Web アプリです。",
  "scripts": {
    "build": "rm -rf dist/gas && vite build --config vite.server.config.ts && node scripts/write-manifest.mjs",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canpok1/google-tasks-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/canpok1/google-tasks-bridge/issues"
  },
  "homepage": "https://github.com/canpok1/google-tasks-bridge#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
